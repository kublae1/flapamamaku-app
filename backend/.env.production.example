# Öffentliche HTTPS-Adresse des FLAPAMAMAKU-Backends.
# Beispiel:
# FLAPAMAMAKU_PUBLIC_URL=https://app.flapamamaku.ch

# Eindeutige Vereinsinstanz. Muss pro Verein einzigartig sein.
FLAPAMAMAKU_INSTANCE_ID=flapamamaku

# Erlaubte Browser-Ursprünge, kommasepariert.
# Für die PC-Adminseite auf derselben Domain genügt die öffentliche HTTPS-Adresse.
FLAPAMAMAKU_ALLOWED_ORIGINS=https://CHANGE-ME.example.ch

# Aktiviert Produktionsschutz wie deaktivierte API-Dokumentation und HSTS.
FLAPAMAMAKU_ENV=production

# Betriebs-/Backup-Parameter.
FLAPAMAMAKU_BACKUP_RETENTION=14
FLAPAMAMAKU_BACKUP_INTERVAL_SECONDS=86400
FLAPAMAMAKU_BUILD_SHA=CHANGE-ME-GIT-SHA

# Optional bei parallelen Pilotinstanzen auf demselben Host.
FLAPAMAMAKU_CONTAINER_NAME=flapamamaku-backend
FLAPAMAMAKU_HOST_PORT=8087
